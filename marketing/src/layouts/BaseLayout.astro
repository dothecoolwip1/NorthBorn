---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Northborn | Field operations from request to revenue',
  description = 'Northborn connects dispatch, jobs, crews, fleet, safety, field tickets, timesheets, clients and billing for industrial field service companies.',
} = Astro.props

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071019" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Northborn" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
